<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002" author="sloiseau">
        <createTable tableName="flight_configs">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="aircraft_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="parameters" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="checksum" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="signature" type="TEXT"/>
            <column name="created_by_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_configs_created_by"
                             references="users(id)"/>
            </column>
            <column name="validated_by_id" type="BIGINT">
                <constraints nullable="true"
                             foreignKeyName="fk_configs_validated_by"
                             references="users(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="validated_at" type="TIMESTAMP"/>
            <column name="loaded_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>